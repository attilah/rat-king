<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>sh.example.billing-relay</string>
  <key>ProgramArguments</key>
  <array><string>/example/bin/private-billing-relay-runner</string></array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>60</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/example/state/billing-relay.stdout.log</string>
  <key>StandardErrorPath</key><string>/example/state/billing-relay.stderr.log</string>
</dict>
</plist>
