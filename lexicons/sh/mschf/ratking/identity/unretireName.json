{
  "lexicon": 1,
  "id": "sh.mschf.ratking.identity.unretireName",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Clear a name's retirement so its mailbox admits mail again. The caller must be an operator, the name's own DID or the host that registered it. cleared is false when the name was not retired.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["name"],
          "properties": { "name": { "type": "string", "maxLength": 128 } }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["name", "did", "cleared"],
          "properties": {
            "name": { "type": "string", "maxLength": 128 },
            "did": { "type": "string", "format": "did" },
            "cleared": { "type": "boolean" }
          }
        }
      },
      "errors": [
        { "name": "InvalidRequest" },
        { "name": "InvalidName" },
        { "name": "AuthRequired" },
        { "name": "Forbidden" },
        { "name": "NameReserved" },
        { "name": "MailboxUnavailable" }
      ]
    }
  }
}
