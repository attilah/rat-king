{
  "lexicon": 1,
  "id": "sh.mschf.ratking.identity.listRetired",
  "defs": {
    "main": {
      "type": "query",
      "description": "Authenticated list of retired names, ordered by name. The cursor is the last name of the previous page, exclusive. A retirement its name's own lease acquisition cleared is not listed.",
      "parameters": {
        "type": "params",
        "properties": {
          "cursor": { "type": "string", "maxLength": 128 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 100 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["retired"],
          "properties": {
            "retired": {
              "type": "array",
              "maxLength": 100,
              "items": { "type": "ref", "ref": "sh.mschf.ratking.identity.retireName#retirement" }
            },
            "cursor": { "type": "string", "maxLength": 128 }
          }
        }
      },
      "errors": [
        { "name": "InvalidRequest" },
        { "name": "AuthRequired" },
        { "name": "MailboxUnavailable" }
      ]
    }
  }
}
