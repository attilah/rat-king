            "type": "string"
          },
          "exempt": {
            "items": {
              "x-pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*/)?[a-z][a-z0-9_-]{0,31}$",
              "type": "string"
            },
            "maxLength": 16,
            "type": "array"
          },
          "note": { "maxLength": 120, "type": "string" },
          "state": { "enum": ["available", "busy", "dnd"], "type": "string" },
          "until": { "format": "datetime", "type": "string" },
          "version": { "const": "0.1", "type": "string" }
        },
        "required": ["state", "version"],
        "type": "object"
      },
      "type": "record"
    }
  },
  "id": "sh.mschf.ratking.attention.status",
